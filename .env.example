# Copy to .env to override the defaults baked into docker-compose.yml.
# .env is git-ignored; real credentials live in GitHub Actions secrets / AWS, never in the repo.
#
# These are local-only development values. The Spring `local` profile
# (backend/incident-service/src/main/resources/application-local.yml) assumes them too.
# Postgres reads the credentials only when its volume is first created, so after
# changing them run `docker compose down -v` to recreate the database.

POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
POSTGRES_HOST_PORT=5433

WEB_PORT=4200
