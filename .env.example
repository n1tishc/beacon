# Copy to .env to override the defaults baked into docker-compose.yml.
# .env is git-ignored; real credentials live in GitHub Actions secrets / AWS, never in the repo.
#
# These are local-only development values. The Spring `local` profiles
# (backend/*/src/main/resources/application-local.yml) assume them too.
# Postgres reads the credentials only when its volume is first created, so after
# changing them run `docker compose down -v` to recreate the database.

POSTGRES_DB=beacon
POSTGRES_USER=beacon
POSTGRES_PASSWORD=beacon
POSTGRES_HOST_PORT=5433

# Password for the seeded demo accounts: admin, responder, viewer.
DEMO_USER_PASSWORD=beacon-demo

# Optional RSA private key (PKCS#8 PEM) for signing JWTs. Leave empty locally: auth-service then
# generates one at startup. Generate one with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048
JWT_SIGNING_KEY=

# The local stack is plain http, where Safari ignores Secure cookies. Must be true behind HTTPS.
AUTH_SECURE_COOKIE=false

# Gateway rate limits (token bucket per client): login per IP per minute, API per user per 10s.
RATE_LIMIT_LOGIN_CAPACITY=10
RATE_LIMIT_API_CAPACITY=100

GATEWAY_PORT=8080
WEB_PORT=4200
