server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;

    # Resolve the gateway's name per request (cached 10 s), not once at startup: when the gateway
    # container is recreated it gets a new IP, and a startup-time lookup would keep answering 502.
    # A variable in proxy_pass is what makes nginx use the resolver.
    resolver ${NGINX_RESOLVER} valid=10s ipv6=off;

    location /api/ {
        set $api_upstream ${API_UPSTREAM};
        proxy_pass $api_upstream;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Hashed bundles never change, so they can be cached forever.
    location ~* \.(?:js|css|svg|woff2?)$ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Client-side routes fall back to the SPA entry point; index.html itself is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri $uri/ /index.html;
    }
}
